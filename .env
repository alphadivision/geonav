# REPLACE THE VALUES BELOW WITH YOUR ACTUAL KEYS IF NOT AUTOMATICALLY SET

# These are placeholder values, not a real project — Google sign-in
# (AccountSection.tsx) is wired up but stays in a clean "not configured yet"
# state until real values are set here. To enable it:
#   1. Create a project at supabase.com (or use an existing one).
#   2. Project Settings > API > copy "Project URL" and "anon public" key
#      into the two values below (both are safe to expose client-side —
#      the anon key is public by design; the actual secret is Google's
#      OAuth client secret, entered only in Supabase's dashboard, never here).
#   3. Authentication > Sign In / Providers > Google > enable it, and paste
#      in a Google OAuth Client ID + Secret from Google Cloud Console
#      (APIs & Services > Credentials > OAuth client ID, type "Web
#      application" — this can be a NEW credential in the same or a
#      different GCP project than the Maps API key above; unrelated to it).
#   4. Authentication > URL Configuration > Redirect URLs — add BOTH:
#        http://localhost:3000
#        https://geonav-red.vercel.app
#      (Supabase redirects back to whatever origin initiated sign-in, so
#      both dev and the current production domain need to be allow-listed.)
NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummykey.updateyourkkey.here
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
NEXT_PUBLIC_GA_MEASUREMENT_ID=your-google-analytics-id-here
NEXT_PUBLIC_ADSENSE_ID=your-adsense-id-here
PERPLEXITY_API_KEY=your-perplexity-api-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here

NEXT_PUBLIC_SITE_URL=https://geonav4154.builtwithrocket.new




NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyCmtzp1Sa2HtWneKTgR1jjl2IYf7_ZubeA

# Required for real heading-up map rotation (vehicle stays "up", map rotates
# underneath it). Google Maps only rotates visually on a VECTOR map, which
# requires a Map ID. Without this set, the app falls back to a classic raster
# map (styled via MAP_STYLES_CONFIG in MapCanvas.tsx) and the map itself will
# NOT rotate, only the arrow icon's heading angle updates.
# Create one at: Google Cloud Console > Google Maps Platform > Map Management
#   1. "Create Map ID" with map type = JavaScript, rendering type = Vector.
#   2. Under that Map ID's style, paste MAP_STYLES_CONFIG.dark from
#      MapCanvas.tsx into the Cloud-based map style editor to keep the dark
#      theme (the `styles` prop is ignored once a mapId is present).
#   3. Paste the generated Map ID below.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=4a3d3590df528fb282214089

# Optional, for the "Show Places" toggle (native map POI visibility).
# Google Maps has no runtime API to toggle POI visibility on an existing
# vector map — it's a per-Map-ID Cloud Console style setting. So this is a
# SEPARATE Map ID, used only while "Show Places" is ON, with its own
# dark+POI and light+POI styles that otherwise match the Map ID above
# exactly (paste the same DARK_STYLES / STANDARD_STYLES JSON, just don't
# add the `{ featureType: 'poi', stylers: [{ visibility: 'off' }] }` /
# `transit` visibility:off rules, or set POI density > none in Cloud
# Console's Map Settings for the light style).
# Create it the same way as NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID above, then paste
# the generated Map ID below. Leaving this unset just means "Show Places"
# has no visible effect (safe no-op) — the app still works fine either way.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID_POI=4a3d3590df528fb2378cefff

GOOGLE_MAPS_SERVER_KEY=

GOOGLE_MAPS_SERVER_API_KEY=AIzaSyADZDwGaV54hqTlOTLuOj99QzJ1aK-h5eo
